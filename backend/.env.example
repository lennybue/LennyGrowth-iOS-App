# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/lennygrowth?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=900        # 15 minutes (seconds)
JWT_REFRESH_EXPIRES_IN=2592000   # 30 days (seconds)

# ─── Apple Sign-In ────────────────────────────────────────────────────────────
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_CLIENT_ID=com.lennardbuessow.lennygrowth
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
# Base64-encoded content of your AuthKey_XXXXXX.p8 file:
APPLE_PRIVATE_KEY_BASE64=BASE64_ENCODED_P8_FILE

# ─── Anthropic AI ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Encryption (for social OAuth tokens stored in DB) ────────────────────────
# 32 bytes hex string (openssl rand -hex 32):
ENCRYPTION_KEY=change_me_to_64_hex_chars_exactly_64_chars_here_0000000000000000

# ─── LinkedIn OAuth (server-side only) ────────────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://api.lennardbuessow.digital/v1/social/callback/linkedin

# ─── Threads / Meta OAuth ─────────────────────────────────────────────────────
THREADS_APP_ID=your_meta_app_id
THREADS_APP_SECRET=your_meta_app_secret
THREADS_REDIRECT_URI=https://api.lennardbuessow.digital/v1/social/callback/threads

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (leave empty to allow all in dev)
ALLOWED_ORIGINS=https://lennardbuessow.digital
